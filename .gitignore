# The guest tree is Apple's libraries and downloaded binaries -- none of it can be
# committed; `prebuilt/unpack.sh` and the curl lines in resume.md put it there.
# The two *sources* that live in it are ours and must survive a fresh clone, so
# they are re-included -- which needs `guests/*` rather than `guests/`, because git
# cannot re-include a file inside an excluded directory.
guests/*
!guests/macos/
guests/macos/*
!guests/macos/build.sh
!guests/macos/threads.c
!guests/macos/files.c
!guests/macos/tls.c
!guests/macos/stub_libs.sh
!guests/macos/hello.txt
tests/*.macho
tests/*.cerr
tests/dylib/*.dylib
tests/dylib/*.macho
tests/dylib/*.native
tests/dylib/expected
tests/dylib/actual
tests/dylib/err
tests/dylib/cerr
mo/
tests/dylib/dsc*
tests/dylib/fake.cache
tests/dylib/expected
tests/dylib/*.s
tests/dylib/*.actual
tests/dylib/cerr3
